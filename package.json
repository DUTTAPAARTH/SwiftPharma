{
  "name": "swiftpharma",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "version": "0.1.0",
  "engines": {
    "node": ">=18 <21"
  },
  "scripts": {
    "build": "npm install && npm run build --workspace=client",
    "start": "npm start --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "testsprite": "powershell -ExecutionPolicy Bypass -File ./start-testsprite.ps1"
  }
}

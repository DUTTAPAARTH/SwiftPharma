{
  "name": "swiftpharma",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "version": "0.1.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm install && npm run build --workspace=client",
    "start": "npm start --workspace=server",
    "dev": "concurrently --kill-others-on-fail --names SERVER,CLIENT --prefix \"[{name}]\" --prefix-colors blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "testsprite": "powershell -ExecutionPolicy Bypass -File ./start-testsprite.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}

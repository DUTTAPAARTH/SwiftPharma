# --- Database -----------------------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/swiftpharma?retryWrites=true&w=majority

# --- Auth ---------------------------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# --- CORS (comma-separated list of allowed frontend origins) ------------------
CLIENT_URL=http://localhost:5173

# --- Cloudinary (image uploads) -----------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payment (Razorpay) -------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- AI providers (at least one required for prescriptions + chat) ------------
# Groq  -- free tier: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Gemini -- https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# OpenAI -- https://platform.openai.com/api-keys
OPENAI_API_KEY=
AI_PRIMARY=groq
AI_FALLBACK=gemini

# Medical MCP (optional drug-interaction service)
MEDICAL_MCP_ENABLED=false

# --- Server -------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# --- Delivery radius (km) -----------------------------------------------------
DELIVERY_AGENT_RADIUS_STRICT_KM=10
DELIVERY_AGENT_RADIUS_DEFAULT_KM=12
DELIVERY_AGENT_RADIUS_EMERGENCY_KM=15
DELIVERY_AGENT_ALLOW_EMERGENCY_DEFAULT=true
